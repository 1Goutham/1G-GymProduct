# Optional — enables Claude in the AI Copilot. Without it the copilot answers
# from the built-in operations engine (fully offline).
ANTHROPIC_API_KEY=

# Shared secret biometric devices / middleware must send as `x-aathlytx-signature`
# (HMAC-SHA256 of the raw body) when posting to /api/biometric/events.
BIOMETRIC_WEBHOOK_SECRET=change-me

# Set to "off" to stop the built-in floor simulator once real devices are connected.
FLOOR_SIMULATOR=on
